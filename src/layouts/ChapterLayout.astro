---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const chapter = frontmatter.chapter;
const total = frontmatter.total;
const story = frontmatter.story;
const prevCh = chapter > 1 ? chapter - 1 : null;
const nextCh = chapter < total ? chapter + 1 : null;
---

<BaseLayout title={frontmatter.title}>
  <article class="chapter-content">
    <h1>{frontmatter.title}</h1>
    <slot />
  </article>

  <nav class="chapter-nav">
    {prevCh ? (
      <a href={`${story}/chuong-${prevCh}`} class="prev">&larr; Chương {prevCh}</a>
    ) : (
      <span></span>
    )}
    <a href={story} class="toc">Mục lục</a>
    {nextCh ? (
      <a href={`${story}/chuong-${nextCh}`} class="next">Chương {nextCh} &rarr;</a>
    ) : (
      <span></span>
    )}
  </nav>
</BaseLayout>

<style>
  .chapter-content {
    max-width: 680px;
    margin: 0 auto;
  }
  .chapter-content h1 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }
  .chapter-content h2 {
    font-size: 1.3rem;
    margin: 2rem 0 0.75rem;
  }
  .chapter-content p {
    margin-bottom: 1.2rem;
    line-height: 1.8;
  }
  .chapter-content em {
    font-style: italic;
  }
  .chapter-content strong {
    font-weight: 600;
  }
  .chapter-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .chapter-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 680px;
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: system-ui, sans-serif;
  }
  .chapter-nav a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .chapter-nav a:hover {
    text-decoration: underline;
  }
  .chapter-nav .toc {
    color: var(--muted);
  }
</style>
